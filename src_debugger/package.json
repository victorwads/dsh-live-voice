{
  "name": "dsh-live-voice-debugger",
  "version": "0.3.2",
  "private": true,
  "type": "module",
  "description": "Optional read-only state inspector for DSH Live Voice.",
  "license": "Apache-2.0",
  "main": "./lib/server.js",
  "exports": {
    ".": "./lib/server.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/",
    "cordis.patch.yml",
    "ARCHITECTURE.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  }
}
