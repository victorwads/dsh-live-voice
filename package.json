{
  "name": "dsh-live-voice",
  "version": "0.3.0",
  "dshTestedVersion": "0.1.6-alpha.2",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test .test-dist/*.test.js",
    "build": "npm run typecheck && node --experimental-strip-types scripts/build.ts",
    "check:dist": "node scripts/check-dist.mjs",
    "dev": "node --experimental-strip-types scripts/build.ts --watch",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"test/**/*.ts\" \"scripts/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\" \"test/**/*.ts\" \"scripts/**/*.ts\"",
    "setup:hooks": "git config core.hooksPath .githooks",
    "prepack": "npm run build"
  },
  "description": "Local-first hands-free AI voice assistant plugin for DeepSeek Harness (DSH), with speech-to-text, text-to-speech, voice commands, and local speech engines.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "local-first",
    "local-voice",
    "hands-free",
    "hands-free-ai",
    "hands-free-assistant",
    "voice-control",
    "voice-commands",
    "voice-assistant",
    "voice-conversation",
    "conversational-ai",
    "continuous-conversation",
    "voice-dictation",
    "spoken-prompts",
    "speech-to-text",
    "text-to-speech",
    "speech-recognition",
    "speech-synthesis",
    "stt",
    "tts",
    "whisper",
    "whisper-cpp",
    "qwen3-asr",
    "qwen3-tts",
    "mlx",
    "apple-silicon",
    "web-speech-api",
    "macos-say",
    "turn-taking",
    "voice-interruption",
    "silence-detection"
  ],
  "author": {
    "name": "wads.dev",
    "url": "https://www.npmjs.com/org/wads.dev"
  },
  "license": "Apache-2.0",
  "files": [
    "src/",
    "lib/",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "PLAN.md",
    "DEVELOPMENT.md",
    "HISTORY.md",
    "docs/",
    "scripts/",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "tag": "latest"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/victorwads/dsh-live-voice.git"
  },
  "devDependencies": {
    "@types/node": "26.6.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "jsdom": "30.1.0",
    "playwright-core": "1.63.0",
    "prettier": "3.9.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "7.0.2"
  },
  "main": "./lib/server.js",
  "exports": {
    ".": "./lib/server.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "dependencies": {
    "@wads.dev/i18n-react": "^0.0.1-alpha.0",
    "@wads.dev/i18n-ts": "0.0.1-alpha.0"
  }
}
